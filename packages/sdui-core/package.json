{
  "name": "@dukaandaar/sdui-core",
  "version": "0.1.0",
  "description": "Universal SDUI contracts, tree/reorder algorithms and headless hooks (zero UI, zero network).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
