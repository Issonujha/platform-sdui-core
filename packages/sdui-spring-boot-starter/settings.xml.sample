<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample Maven settings for publishing the starter to GitHub Packages.
  Copy to ~/.m2/settings.xml and fill in a PAT with `write:packages`.

  The <id> MUST be `github` to match <distributionManagement><repository><id>
  in pom.xml, otherwise `mvn deploy` fails with "repository not configured".
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>GITHUB_ACTOR</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
    </servers>
</settings>
