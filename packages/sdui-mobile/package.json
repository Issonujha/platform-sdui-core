{
  "name": "@dukaandaar/sdui-mobile",
  "version": "0.1.0",
  "description": "React Native / Expo SDUI components (data-in/callback-out; no network of its own).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no tests yet\" && exit 0"
  },
  "dependencies": {
    "@dukaandaar/sdui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.5.4"
  }
}
